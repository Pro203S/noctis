{
  "name": "noctis",
  "module": "index.ts",
  "type": "module",
  "version": "0.0.0",
  "description": "Terminal User Interfaces",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Pro203S",
  "license": "MIT",
  "scripts": {
    "pack": "npm run clean && npm run build",
    "build": "tsc",
    "clean": "tsc --build --clean",
    "dev": "nodemon --exec ts-node src/index.ts",
    "watch": "tsc --watch",
    "test:reconciler-runtime": "tsc --noCheck --rootDir src --outDir .cache/reconciler-runtime && node --test test/runtime/reconciler.test.mjs",
    "test:reconciler-types": "tsc --declaration --emitDeclarationOnly --noCheck --rootDir src --outDir .cache/reconciler-types && tsc --ignoreConfig --noEmit --strict --target ES6 --module Node16 --moduleResolution Node16 --types node test/types/reconciler.test.ts",
    "test": "npm run pack && node \"test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pro203S/noctis.git"
  },
  "keywords": [
    "terminal",
    "react",
    "ui",
    "render"
  ],
  "homepage": "https://github.com/Pro203S/noctis.git",
  "bugs": {
    "url": "https://github.com/Pro203S/noctis/issues"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.33.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@types/node": "^22.20.3",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0"
  }
}
